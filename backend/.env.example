# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to Git.

# --- Database ---
DB_NAME=cv_analysis_db
DB_USERNAME=cv_admin
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
JPA_DDL_AUTO=update

# --- JWT ---
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# Comma-separated list of allowed frontend origins, no trailing slash
CORS_ALLOWED_ORIGINS=https://your-domain.com,http://localhost:5173

# --- Business rules ---
MAX_FREE_ANALYSES=3

# --- Gmail SMTP (for OTP emails) ---
# Use a Google "App Password", NOT your real Gmail password:
# https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
MAIL_FROM=your-account@gmail.com

# --- Gemini AI ---
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3.6-flash

# --- VNPay sandbox (https://sandbox.vnpayment.vn) ---
VNPAY_TMN_CODE=CHANGE_ME
VNPAY_HASH_SECRET=CHANGE_ME
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Must be a publicly reachable URL of THIS backend (note the /api/v1 context path)
VNPAY_RETURN_URL=https://api.your-domain.com/api/v1/payment/vnpay-return
VNPAY_PLUS_PRICE=25000

# --- Misc ---
FRONTEND_BASE_URL=https://your-domain.com
# First registered account with this email is auto-promoted to ADMIN on OTP verification
ADMIN_BOOTSTRAP_EMAIL=admin@your-domain.com
