# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to Git.

# --- Database ---
DB_NAME=cv_analysis_db
DB_USERNAME=cv_admin
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
JPA_DDL_AUTO=update

# --- JWT ---
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# Comma-separated list of allowed frontend origins, no trailing slash
CORS_ALLOWED_ORIGINS=https://your-domain.com,http://localhost:5173

# --- Business rules ---
MAX_FREE_ANALYSES=3

# --- Gmail SMTP (for OTP emails) ---
# Use a Google "App Password", NOT your real Gmail password:
# https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
MAIL_FROM=your-account@gmail.com

# --- Gemini AI ---
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3.6-flash
# Tried in order when the main model is overloaded or retired (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# --- YouTube Data API v3 (for real, specific video links) ---
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# 1. Vào Google Cloud Console -> chọn/tạo project -> Enable "YouTube Data API v3"
# 2. Credentials -> Create Credentials -> API key
YOUTUBE_API_KEY=CHANGE_ME

# --- JSearch (RapidAPI) — real job postings, free tier 200 requests/month ---
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Đăng ký RapidAPI (miễn phí) -> Subscribe gói Basic (Free) của JSearch -> copy "X-RapidAPI-Key"
RAPIDAPI_KEY=CHANGE_ME

# --- VNPay sandbox (https://sandbox.vnpayment.vn) ---
VNPAY_TMN_CODE=CHANGE_ME
VNPAY_HASH_SECRET=CHANGE_ME
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Must be a publicly reachable URL of THIS backend (note the /api/v1 context path)
VNPAY_RETURN_URL=https://api.your-domain.com/api/v1/payment/vnpay-return
VNPAY_PLUS_PRICE=25000

# --- Misc ---
FRONTEND_BASE_URL=https://your-domain.com
# First registered account with this email is auto-promoted to ADMIN on OTP verification
ADMIN_BOOTSTRAP_EMAIL=admin@your-domain.com
